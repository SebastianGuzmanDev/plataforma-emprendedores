# Copia este archivo como .env (no se versiona) y exporta las variables en producción.
DJANGO_SETTINGS_MODULE=config.settings.prod
DJANGO_SECRET_KEY=cambia-esta-clave-por-una-larga-y-aleatoria
DJANGO_ALLOWED_HOSTS=emprendedores.ejemplo.edu.co
# Dominios de correo aceptados como institucionales (separados por coma)
DOMINIOS_INSTITUCIONALES=amigo.edu.co
# Correo saliente para la recuperación de contraseña (HU-03)
EMAIL_HOST=smtp.ejemplo.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=no-responder@ejemplo.edu.co
# Canal para que los titulares ejerzan sus derechos (Ley 1581 de 2012)
CORREO_CONTACTO_PRIVACIDAD=privacidad@ejemplo.edu.co
# 1 si la app corre detrás de un proxy que termina TLS (X-Forwarded-Proto)
DJANGO_DETRAS_DE_PROXY=1
